{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Balance",
  "version": "0.1.0",
  "identifier": "local.codex.balance",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
